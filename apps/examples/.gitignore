# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# The navigation plan is a build-time intermediate; the lowered flow document
# (*.flow.json) is a committed bundled delivery artifact, like the .rfw blobs.
assets/paywalls/*.navplan.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Restage generated output.
#
# Portable build metadata and build-time intermediates are ignored by artifact
# name: they are reproducible from the authored sources by
# `dart run build_runner build`, and tracking them adds hundreds of kilobytes of
# churn to every generation. Generated Dart is NOT ignored — it is ordinary
# source the analyzer and the compiler read.
restage.outputs.json
restage.publication.json
restage_a2ui_catalog.a2ui.json
surface_publication.compiler.json
assets/restage/source-index.json
assets/restage/output-roster.json
*.restage.md

# Bundles are build output too, but the ones routed into the Flutter asset
# directory ship with the package: pub publishes the working tree, so an
# untracked bundle would leave a published example unable to render its own
# surfaces. Only those are tracked.
*.rsbundle
!assets/restage/bundles/**/*.rsbundle
