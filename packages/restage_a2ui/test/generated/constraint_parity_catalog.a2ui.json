                    "$ref": "common_types.json#/$defs/DataBinding"
                  },
                  {
                    "$ref": "common_types.json#/$defs/FunctionCall"
                  }
                ]
              },
              "props_ratio": {
                "oneOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0.25,
                    "exclusiveMaximum": 0.75
                  },
                  {
                    "$ref": "common_types.json#/$defs/DataBinding"
                  },
                  {
                    "$ref": "common_types.json#/$defs/FunctionCall"
                  }
                ]
              },
              "props_code": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z]{2}[0-9]+$",
                    "minLength": 3,
                    "maxLength": 8
                  },
                  {
                    "$ref": "common_types.json#/$defs/DataBinding"
                  },
                  {
                    "$ref": "common_types.json#/$defs/FunctionCall"
                  }
                ]
              },
              "props_items": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/restage_component_ConstraintParity/$defs/ConstraintRecursiveItem"
