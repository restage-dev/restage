                    "minItems": 1,
                    "maxItems": 4
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "props_legacyCount": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": -10,
                    "maximum": 10
                  },
                  {
                    "$ref": "common_types.json#/$defs/DataBinding"
                  },
                  {
                    "$ref": "common_types.json#/$defs/FunctionCall"
                  }
                ]
              },
