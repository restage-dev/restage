    "catalogId": "restage:catalog/sha256/ca8f148a8b1ad4e46d46a77d8b4bfc3b2d3d861bbd39eba0b18ac8cf5753140b",
    "instructions": "For every A2UI createSurface message, set catalogId to \"restage:catalog/sha256/ca8f148a8b1ad4e46d46a77d8b4bfc3b2d3d861bbd39eba0b18ac8cf5753140b\".\nPlanCard constructor fields: plan => props_plan.\nFeatureGrid: A grid of plan features with inclusion flags.\nFeatureGrid constructor fields: features => props_features.\nGlossary constructor fields: terms => props_terms.\nMetaBar constructor fields: meta => props_meta.\nLinkCard constructor fields: link => props_link.\nCommentThread constructor fields: root => props_root.",
    "components": {
