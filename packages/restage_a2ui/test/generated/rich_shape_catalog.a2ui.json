{
  "restageCapability": {
    "catalogContentVersion": 1,
    "availableLibraries": [],
    "perItemSinceVersion": {
      "CommentThread": 1,
      "FeatureGrid": 1,
      "Glossary": 1,
      "LinkCard": 1,
      "MetaBar": 1,
      "PlanCard": 1
    }
  },
  "a2uiCatalog": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "restage:catalog/sha256/f999eaa59ed1e8bbb278a44c401904b6d7bd06732820929d8c22195e525f2c31",
    "title": "Restage A2UI Catalog",
    "description": "A2UI component catalog generated from Restage widget source.",
    "catalogId": "restage:catalog/sha256/f999eaa59ed1e8bbb278a44c401904b6d7bd06732820929d8c22195e525f2c31",
    "a2uiProtocolVersion": "0.9.1",
    "components": {
      "CommentThread": {
        "$defs": {
          "Comment": {
            "type": "object",
            "description": "A comment that may link to one nested reply.",
            "properties": {
              "reply": {
                "description": "The next reply in the thread.",
                "anyOf": [
                  {
                    "$ref": "#/$defs/Comment"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "text": {
                "type": "string",
                "description": "The comment text."
              }
            },
            "required": [
              "text"
            ]
          },
          "__a2ui_root__": {
            "type": "object",
            "properties": {
              "root": {
                "description": "The root comment of a recursive reply thread.",
                "$ref": "#/$defs/Comment"
              }
            },
            "required": [
              "root"
            ]
          }
        },
        "$ref": "#/$defs/__a2ui_root__",
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "CommentThread"
            ]
          }
        },
        "required": [
          "component"
        ]
      },
      "FeatureGrid": {
        "type": "object",
        "description": "A grid of plan features with inclusion flags.",
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A list-of-objects element.",
              "properties": {
                "included": {
                  "type": "boolean"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "included",
                "label"
              ]
            }
          },
          "component": {
            "type": "string",
            "enum": [
              "FeatureGrid"
            ]
          }
        },
        "required": [
          "component",
          "features"
        ]
      },
      "Glossary": {
        "type": "object",
        "properties": {
          "terms": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "component": {
            "type": "string",
            "enum": [
              "Glossary"
            ]
          }
        },
        "required": [
          "component",
          "terms"
        ]
      },
      "LinkCard": {
        "type": "object",
        "properties": {
          "link": {
            "type": "object",
            "description": "A nested object whose own field is named `path` — the exact shape genui's BoundObject would have misread as a `{path: ...}` binding. Direct reconstruction reads the field by name, so it renders correctly.",
            "properties": {
              "label": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "path"
            ]
          },
          "component": {
            "type": "string",
            "enum": [
              "LinkCard"
            ]
          }
        },
        "required": [
          "component",
          "link"
        ]
      },
      "MetaBar": {
        "type": "object",
        "properties": {
          "meta": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "count",
              "title"
            ]
          },
          "component": {
            "type": "string",
            "enum": [
              "MetaBar"
            ]
          }
        },
        "required": [
          "component",
          "meta"
        ]
      },
      "PlanCard": {
        "$defs": {
          "PlanTier": {
            "type": "object",
            "description": "A nested data class: required scalars + a nullable enum + a nullable string.",
            "properties": {
              "badge": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "none",
                      "popular",
                      "bestValue"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "type": "string"
              },
              "price": {
                "type": "number"
              },
              "tagline": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "price"
            ]
          },
          "__a2ui_root__": {
            "type": "object",
            "properties": {
              "plan": {
                "description": "The plan tier this card presents.",
                "$ref": "#/$defs/PlanTier"
              }
            },
            "required": [
              "plan"
            ]
          }
        },
        "$ref": "#/$defs/__a2ui_root__",
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "PlanCard"
            ]
          }
        },
        "required": [
          "component"
        ]
      }
    },
    "functions": {},
    "systemPromptFragments": [
      "For every A2UI createSurface message, set catalogId to \"restage:catalog/sha256/f999eaa59ed1e8bbb278a44c401904b6d7bd06732820929d8c22195e525f2c31\".",
      "FeatureGrid: A grid of plan features with inclusion flags."
    ]
  }
}
