          "label": {
            "type": "string",
            "description": "Required positional label."
          },
          "enabled": {
            "description": "Optional named value whose omission preserves the Dart default.",
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
