                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "path"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "call": {
                        "type": "string"
                      },
                      "args": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "call"
                    ]
                  }
                ]
              },
              "count": {
                "description": "Integer constructor default and second write-back candidate.",
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "path"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "call": {
                        "type": "string"
                      },
                      "args": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "call"
                    ]
                  }
                ]
              },
              "mode": {
                "type": "string",
                "description": "Enum constructor default.",
                "enum": [
                  "ready",
                  "processing"
                ]
              },
              "directColor": {
                "type": "string",
                "description": "Direct const invocation default."
              },
              "publicColor": {
                "type": "string",
                "description": "Public static constant reference default."
              },
              "data": {
                "description": "Nested customer-structured default.",
                "$ref": "#/$defs/ConstructorCorpusData"
              }
            },
            "required": [
              "value",
              "ordinaryLabel",
              "requiredNamed"
            ]
          }
        },
        "$ref": "#/$defs/__a2ui_root__",
        "properties": {
          "component": {
            "type": "string",
            "enum": [
