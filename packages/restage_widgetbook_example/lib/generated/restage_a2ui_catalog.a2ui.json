          "props"
        ]
      },
      "CatalogShowcase": {
        "$defs": {
          "CatalogShowcaseData": {
            "type": "object",
            "description": "Customer-owned structured information displayed by a [CatalogShowcase].",
            "properties": {
              "count": {
                "type": "integer",
                "description": "Customer-owned count."
              },
              "note": {
                "type": "string",
                "description": "Supporting customer text."
              }
            },
            "required": [
              "count",
              "note"
            ]
          },
          "__a2ui_root__": {
            "type": "object",
            "description": "A customer catalog widget proving one source can feed every enabled target. It combines ordinary scalar state, an enum, callback write-back, native child-bearing inputs, and customer-owned structured data. The independently named `hero`, `details`, and `footer` inputs require no slot annotation.\n\nThe second paragraph is retained in generated property metadata so multi-paragraph Dart documentation is never reduced to its first line.",
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Visible customer title."
                  },
                  "enabled": {
                    "description": "Whether the customer control is enabled.",
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "call": {
                            "type": "string"
                          },
                          "args": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "required": [
                          "call"
                        ]
                      }
                    ]
                  },
                  "status": {
                    "type": "string",
                    "description": "Current customer state.",
                    "enum": [
                      "ready",
                      "processing"
                    ]
                  },
                  "hero": {
                    "type": "string",
                    "description": "Customer widget shown before the detail list."
                  },
                  "details": {
                    "type": "array",
                    "description": "Customer detail widgets shown in source order.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "footer": {
                    "description": "Optional customer widget shown after the detail list.",
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "data": {
                    "description": "Customer-owned structured information.",
                    "$ref": "#/$defs/CatalogShowcaseData"
                  }
                },
                "required": [
                  "title",
                  "status",
                  "hero",
                  "details",
                  "data"
                ]
              }
            },
            "required": [
              "props"
            ]
          }
        },
        "$ref": "#/$defs/__a2ui_root__",
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "CatalogShowcase"
            ]
          }
        },
        "required": [
          "component"
        ]
      },
