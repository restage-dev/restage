  "a2uiCatalog": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "restage:catalog/sha256/f7fafb43851aee19ed173cdb591a4f1f036aff27d88081c5578aa80d507167e9",
    "title": "Restage A2UI Catalog",
    "description": "A2UI component catalog generated from Restage widget source.",
    "catalogId": "restage:catalog/sha256/f7fafb43851aee19ed173cdb591a4f1f036aff27d88081c5578aa80d507167e9",
    "a2uiProtocolVersion": "0.9.1",
    "components": {
      "CatalogShowcase": {
        "$defs": {
          "CatalogShowcaseData": {
            "type": "object",
            "description": "Customer-owned structured information displayed by a [CatalogShowcase].",
            "properties": {
              "count": {
                "type": "integer",
                "description": "Customer-owned count."
              },
              "note": {
                "type": "string",
                "description": "Supporting customer text."
              }
            },
            "required": [
              "count",
              "note"
            ]
          },
          "__a2ui_root__": {
            "type": "object",
            "description": "A customer catalog widget proving one source can feed every enabled target. It combines ordinary scalar state, an enum, callback write-back, native child slots, and customer-owned structured data.\n\nThe second paragraph is retained in generated property metadata so multi-paragraph Dart documentation is never reduced to its first line.",
            "properties": {
              "title": {
                "type": "string",
                "description": "Visible customer title."
              },
              "enabled": {
                "description": "Whether the customer control is enabled.",
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "path"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "call": {
                        "type": "string"
                      },
                      "args": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "call"
                    ]
                  }
                ]
              },
              "status": {
                "type": "string",
                "description": "Current customer state.",
                "enum": [
                  "ready",
                  "processing"
                ]
              },
              "header": {
                "type": "string",
                "description": "Customer widget shown before the content list."
              },
              "children": {
                "type": "array",
                "description": "Customer widgets shown in source order.",
                "items": {
                  "type": "string"
                }
              },
              "data": {
                "description": "Customer-owned structured information.",
                "$ref": "#/$defs/CatalogShowcaseData"
              }
            },
            "required": [
              "title",
              "status",
              "header",
              "children",
              "data"
            ]
          }
        },
        "$ref": "#/$defs/__a2ui_root__",
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "CatalogShowcase"
            ]
          }
        },
        "required": [
          "component"
        ]
      },
      "ConstructorFidelityCorpus": {
        "$defs": {
          "ConstructorCorpusData": {
            "type": "object",
            "description": "Customer-owned structured data with one nested object.",
            "properties": {
              "count": {
                "type": "integer",
                "description": "Customer-owned scalar nested beside the object."
              },
              "nested": {
                "description": "Nested customer object.",
                "$ref": "#/$defs/ConstructorCorpusNestedData"
              }
            },
            "required": [
              "count",
              "nested"
            ]
