              }
            },
            "required": [
              "label"
            ]
          },
          "__a2ui_root__": {
            "type": "object",
            "description": "Broad reusable fixture for accepted named constructor shapes.",
            "properties": {
              "value": {
                "type": "string",
                "description": "Generic value inherited by the concrete customer widget."
              },
              "ordinaryLabel": {
                "type": "string",
                "description": "Ordinary one-to-one constructor binding."
              },
              "requiredNamed": {
                "type": "string",
                "description": "Required named field formal."
              },
              "nullableText": {
                "description": "Explicit nullable null default.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "nullableSeed": {
                "description": "Nullable input with a non-null constructor default.",
